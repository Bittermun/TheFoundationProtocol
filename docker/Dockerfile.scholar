# Dockerfile.scholar: Screenless Audio Scholar Appliance Container
# Includes espeak-ng offline text-to-speech engine and ALSA audio utilities.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    alsa-utils \
    iproute2 \
    iptables \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy protocol repository
COPY . /app

ENV PYTHONPATH=/app:/app/tfp-foundation-protocol
ENV PYTHONUNBUFFERED=1

EXPOSE 9999/udp

# Run headless Audio Scholar appliance listening on UDP 9999
CMD ["python", "-m", "tfp_core_v4.cli", "audio-scholar", "--port", "9999"]
